model AssetAssignment {
  id           String       @id @default(uuid())
  asset        Asset        @relation("AssetToAssignments", fields: [assetId], references: [id], onDelete: Cascade)
  assetId      String
  recordStatus RecordStatus @default(PENDING_APPROVAL)

  assignedToType AssignmentType
  assignedToId   String? // Polymorphic: can be Employee.id, Project.id, etc.

  // Optional relations – connect whichever makes sense
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  employeeId String?
  project    Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId  String?
  // Add more: departmentId, organizationId, etc. if needed

  checkedOutAt   DateTime @default(now())
  checkedOutBy   User?    @relation("CheckedOutBy", fields: [checkedOutById], references: [id], onDelete: SetNull)
  checkedOutById String?

  expectedReturn DateTime?
  actualReturn   DateTime?

  returnedBy        User?   @relation("ReturnedBy", fields: [returnedById], references: [id], onDelete: SetNull)
  returnedById      String?
  purpose           String? // e.g. "Field work in Kano", "Office use"
  conditionOnReturn String? // e.g. "Good", "Damaged - screen cracked"
  notes             String?

  isActive Boolean @default(true) // true = checked out, false = returned

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletedAt   DateTime?
  deletedBy   User?     @relation("AssetAssignmentDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  deletedById String?

  createdBy   User?   @relation("AssetAssignmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?

  // For quick query of currently assigned assets
  @@index([assetId, isActive])
}

model AssetDepreciation {
