model Asset {
  id              String       @id @default(uuid())
  assetTag        String       @unique // e.g. "LAG-CMP-001"
  name            String
  avatar          String?
  url             String?
  recordStatus    RecordStatus @default(PENDING_APPROVAL)
  originalName    String?
  description     String?
  serialNumber    String?
  model           String?
  manufacturer    String?
  purchaseDate    DateTime?
  purchasePrice   Float?
  currency        String?      @default("NGN")
  salvageValue    Float?       @default(0)
  usefulLifeYears Int? // e.g. 5 years

  depreciationMethod DepreciationMethod @default(STRAIGHT_LINE)
  status             AssetStatus        @default(AVAILABLE)
  category           AssetCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId         String?

  location   OfficeLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  locationId String?

  notes String?

  // Current assignment (optional – for quick query; history in AssetAssignment)
  //currentAssignment   AssetAssignment? @relation("CurrentAssignment")

  assignments   AssetAssignment[]   @relation("AssetToAssignments")
  depreciations AssetDepreciation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletedAt   DateTime?
  deletedBy   User?     @relation("AssetDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  deletedById String?

  createdBy   User?   @relation("AssetCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?

  currentBookValue Float? // Denormalized for fast reads/queries
  disposedAt       DateTime?
  disposalMethod   AssetDisposalMethod?
  disposalValue    Float?
  disposalNotes    String?

  // Project-based allocation (many-to-many with percentage support)
  projectAllocations AssetProjectAllocation[]

  disposal   AssetDisposal? @relation("AssetDisposalRelation")
  disposalId String?

  @@map("assets")
}

model AssetProjectAllocation {
  id           String       @id @default(uuid())
  recordStatus RecordStatus @default(PENDING_APPROVAL)
  asset        Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  assetId      String
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId    String

  allocationPercentage Float @default(100) // 100 = fully allocated to this project

  allocatedAt   DateTime  @default(now())
  deallocatedAt DateTime?

  deletedAt   DateTime?
  deletedBy   User?     @relation("AssetProjectAllocationDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  deletedById String?

  createdBy   User?   @relation("AssetProjectAllocationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?

  @@unique([assetId, projectId])
  @@map("asset_project_allocations")
}

model AssetDisposal {
