  periodEnd            DateTime
  submittedAt          DateTime?
  supervisorApprovedAt DateTime?
  hrApprovedAt         DateTime?
  entries              TimesheetEntry[]

  rejectionReason String?
  approvalStatus  ApprovalStatus @default(PENDING)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  deletedAt   DateTime?
  deletedBy   User?     @relation("TimesheetDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  deletedById String?

  createdBy   User?   @relation("TimesheetCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
}

model TimesheetEntry {
  id String @id @default(uuid())

  timesheetId String
  timesheet   Timesheet          @relation(fields: [timesheetId], references: [id])
  date        DateTime
  hours       Float
  type        TimesheetEntryType
  createdAt   DateTime           @default(now())
}

model GeoFence {
  id           String @id @default(uuid())
  name         String
  latitude     Float
  longitude    Float
  radiusMeters Float
}

model ApprovalWorkflow {
  id       String         @id @default(uuid())
  name     String
  module   WorkflowModule
  isActive Boolean        @default(true)

  levels    ApprovalLevel[]
  requests  ApprovalRequest[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  deletedAt   DateTime?
  deletedBy   User?     @relation("ApprovalWorkflowDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  deletedById String?

  createdBy   User?   @relation("ApprovalWorkflowCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
}

model PromotionRequest {
  id              String         @id @default(uuid())
  employeeId      String
  currentGradeId  String
  proposedGradeId String
  reason          String
  status          ApprovalStatus @default(PENDING)
  requestedAt     DateTime       @default(now())
  approvedAt      DateTime?

  employee Employee @relation(fields: [employeeId], references: [id])
}

//Defines what type of workflow this is (e.g., Recruitment Approval).

model BeneficiaryFeedback {
  id            String            @id @default(uuid())
  beneficiaryId String
  beneficiary   Beneficiary       @relation(fields: [beneficiaryId], references: [id])
  submittedById String?
  submittedBy   User?             @relation("SubmittedBy", fields: [submittedById], references: [id])
  feedbackType  FeedbackType
  category      FeedbackCategory?

  subject  String?
  message  String
  priority Priority       @default(MEDIUM)
  status   FeedbackStatus @default(OPEN)

  assignedToId String?
  assignedTo   User?     @relation("AssignedTo", fields: [assignedToId], references: [id])
  response     String?
  respondedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([beneficiaryId])
  @@index([status])
  @@index([feedbackType])
}

model ApprovalLevel {
  id         String           @id @default(uuid())
  workflowId String
  workflow   ApprovalWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  levelOrder      Int
  roleId          String
  role            UserRole @relation(fields: [roleId], references: [id])
  escalationHours Int?
  isFinal         Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletedAt   DateTime?
  deletedBy   User?     @relation("ApprovalLevelDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  deletedById String?

  createdBy   User?   @relation("ApprovalLevelCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?

  @@unique([workflowId, levelOrder])
}

// Defines each step in the approval chain.

model ApprovalRequest {
  id         String           @id @default(uuid())
  workflowId String
  workflow   ApprovalWorkflow @relation(fields: [workflowId], references: [id])

  referenceId  String // e.g Vacancy ID
  module       WorkflowModule
  status       ApprovalStatus @default(PENDING)
  currentLevel Int            @default(1)

  initiatedById String
  initiatedBy   User     @relation("ApprovalRequestInitiateddBy", fields: [initiatedById], references: [id])
  initiatedAt   DateTime @default(now())

  history ApprovalHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletedAt   DateTime?
  deletedBy   User?     @relation("ApprovalRequestDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  deletedById String?

  createdBy   User?   @relation("ApprovalRequestCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
}

// Created when a workflow is triggered.

model ApprovalHistory {
  id                String          @id @default(uuid())
  approvalRequestId String
  approvalRequest   ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)

  levelOrder Int
  actedById  String
  action     ApprovalStatus
  comment    String?

  createdAt DateTime @default(now())
}

model EmployeeAttendanceProfile {
  id String @id @default(uuid())

  employeeId String   @unique
  employee   Employee @relation(fields: [employeeId], references: [id])

  workScheduleId String?
  workSchedule   WorkSchedule? @relation(fields: [workScheduleId], references: [id])

  shiftType          ShiftType
  attendancePolicyId String?
  attendancePolicy   AttendancePolicy? @relation(fields: [attendancePolicyId], references: [id])

  overtimeEligible  Boolean        @default(false)
  trackingMethod    TrackingMethod
  geoFencingEnabled Boolean        @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AttendancePolicy {
  id                     String @id @default(uuid())
  name                   String @unique
  gracePeriodMinutes     Int
  maxLateOccurrences     Int
  lateToAbsenceThreshold Int

  absencePenaltyEnabled     Boolean
  overtimeThresholdHours    Float
  employeeAttendanceProfile EmployeeAttendanceProfile[]

  compOffAccrualEnabled Boolean
  createdAt             DateTime @default(now())
}

model BeneficiaryFollowUp {
  id String @id @default(uuid())

  visitId String
  visit   BeneficiaryFieldVisit @relation(fields: [visitId], references: [id])

  assignedToId String?
  assignedTo   User?   @relation(fields: [assignedToId], references: [id])

  action      String
  description String?

  dueDate     DateTime?
  completedAt DateTime?

  status FollowUpStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model Message {
  id String @id @default(uuid())

  sender   User   @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  senderId String

  receiver   User   @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  receiverId String

  content String
  type    MessageType @default(DIRECT_MESSAGE)

  // Core notification/message flags
  isRead Boolean   @default(false)
  readAt DateTime?

  // Optional: allow users to mark as important / archive / etc.
  isArchived Boolean @default(false)
  isStarred  Boolean @default(false)

  // Useful for later filtering / grouping
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
  @@index([isRead, createdAt(sort: Desc)])
}

model WorkSchedule {
  id   String @id @default(uuid())
  name String @unique

  workingDays          String // JSON or "MON,TUE,WED,THU,FRI"
  dailyWorkingHours    Float
  breakDurationMinutes Int

  startTime DateTime
  endTime   DateTime

  flexibleStartWindow Int? // minutes
  flexibleEndWindow   Int?

  holidayCalendarId String?
  holidayCalendar   HolidayCalendar? @relation(fields: [holidayCalendarId], references: [id])

  isNightShift              Boolean                     @default(false)
  shifts                    Shift[]
  employeeAttendanceProfile EmployeeAttendanceProfile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletedAt   DateTime?
  deletedBy   User?     @relation("WorkScheduleDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  deletedById String?

  createdBy   User?   @relation("WorkScheduleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
}

model PayrollCalendar {
  id          String          @id @default(uuid())
  name        String          @unique
  description String?
  frequency   PayFrequency
  payDay      Int?
  isActive    Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  periods     PayrollPeriod[]
}

