datasource db {
  provider = "postgresql"
  url      = env("DB_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String       @id @default(uuid())
  username         String       @unique
  password         String
  role             Role         @default(USER)
  status           UserStatus   @default(ACTIVE)
  employeeId       String?      @unique
  employee         Employee?    @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  beneficiaryId    String?      @unique
  beneficiary      Beneficiary? @relation(fields: [beneficiaryId], references: [id], onDelete: SetNull)
  resetToken       String?
  resetTokenExpiry DateTime?

  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  userActivity       UserActivity[]
  beneficiaryRequest BeneficiaryRequest[]
  submittedBy        BeneficiaryFeedback[] @relation("SubmittedBy")
  requestSubmittedBy BeneficiaryRequest[]  @relation("RequestSubmittedBy")
  assignedTo         BeneficiaryFeedback[] @relation("AssignedTo")
  userSettings       UserSettings[]
  roles              UserRoleAssignment[] // ✅ multiple roles
  sentMessages       Message[]             @relation("SentMessages")
  receivedMessages   Message[]             @relation("ReceivedMessages")

  interventionBatch             InterventionBatch[]            @relation("InterventionBatchCreatedBy")
  createdUsers                  User[]                         @relation("UserCreatedBy")
  createdRoleModulePermission   RoleModulePermission[]         @relation("RoleModulePermissionCreatedBy")
  createdEmployee               Employee[]                     @relation("EmployeeCreatedBy")
  createdSystemCheck            SystemCheck[]                  @relation("SystemCheckCreatedBy")
  createdDonor                  Donor[]                        @relation("DonorCreatedBy")
  createdProgram                Program[]                      @relation("ProgramCreatedBy")
  createdProjectDonor           ProjectDonor[]                 @relation("ProjectDonorCreatedBy")
  createdProjectEmployee        ProjectEmployee[]              @relation("ProjectEmployeeCreatedBy")
  createdProject                Project[]                      @relation("ProjectCreatedBy")
  createdNigeriaState           NigeriaState[]                 @relation("NigeriaStateCreatedBy")
  createdEmergencyContact       EmergencyContact[]             @relation("EmergencyContactCreatedBy")
  createdContactInfo            ContactInfo[]                  @relation("ContactInfoCreatedBy")
  createdEmploymentHistory      EmploymentHistory[]            @relation("EmploymentHistoryCreatedBy")
  createdGender                 Gender[]                       @relation("GenderCreatedBy")
  createdPersonalInfo           PersonalInfo[]                 @relation("PersonalInfoCreatedBy")
  createdVacancy                Vacancy[]                      @relation("VacancyCreatedBy")
  createdMarritalStatus         MarritalStatus[]               @relation("MarritalStatusCreatedBy")
  createdShift                  Shift[]                        @relation("ShiftCreatedBy")
  createdShiftEmployee          ShiftEmployee[]                @relation("ShiftEmployeeCreatedBy")
  createdAttendance             Attendance[]                   @relation("AttendanceCreatedBy")
  createdLeaveRequest           LeaveRequest[]                 @relation("LeaveRequestCreatedBy")
  createdLeaveType              LeaveType[]                    @relation("LeaveTypeCreatedBy")
  createdInterventionCategory   InterventionCategory[]         @relation("InterventionCategoryCreatedBy")
  createdTraining               Training[]                     @relation("TrainingCreatedBy")
  createdTrainingEnrollment     TrainingEnrollment[]           @relation("TrainingEnrollmentCreatedBy")
  createdEmployeeDegree         EmployeeDegree[]               @relation("EmployeeDegreeCreatedBy")
  createdEmployeeCertificate    EmployeeCertificate[]          @relation("EmployeeCertificateCreatedBy")
  createdOrganization           Organization[]                 @relation("OrganizationCreatedBy")
  createdCase                   Case[]                         @relation("CaseCreatedBy")
  createdIntervention           Intervention[]                 @relation("InterventionCreatedBy")
  createdCaseAssessment         CaseAssessment[]               @relation("CaseAssessmentCreatedBy")
  createdService                Service[]                      @relation("ServiceCreatedBy")
  createdIncident               Incident[]                     @relation("IncidentCreatedBy")
  createdCaseNote               CaseNote[]                     @relation("CaseNoteCreatedBy")
  createdOrgDocs                OrgDocs[]                      @relation("OrgDocsCreatedBy")
  createdOfficeLocation         OfficeLocation[]               @relation("OfficeLocationCreatedBy")
  createdOfficePosition         OfficePosition[]               @relation("OfficePositionCreatedBy")
  reportedDisciplinaryCase      DisciplinaryCase[]             @relation("DisciplinaryReportedBy")
  disciplinaryInvestigator      DisciplinaryCase[]             @relation("DisciplinaryInvestigator")
  createdDisciplinaryCreatedBy  DisciplinaryCase[]             @relation("DisciplinaryCreatedBy")
  createdGrievance              Grievance[]                    @relation("GrievanceCreatedBy")
  createdServiceType            ServiceType[]                  @relation("ServiceTypeCreatedBy")
  createdAssetCategory          AssetCategory[]                @relation("AssetCategoryCreatedBy")
  createdAsset                  Asset[]                        @relation("AssetCreatedBy")
  createdCheckedOutBy           AssetAssignment[]              @relation("CheckedOutBy")
  createdReturnedBy             AssetAssignment[]              @relation("ReturnedBy")
  createdAssetAssignment        AssetAssignment[]              @relation("AssetAssignmentCreatedBy")
  createdAssetDepreciation      AssetDepreciation[]            @relation("AssetDepreciationCreatedBy")
  createdAssetDisposal          AssetDisposal[]                @relation("AssetDisposalCreatedBy")
  createdAssetProjectAllocation AssetProjectAllocation[]       @relation("AssetProjectAllocationCreatedBy")
  createdPayrollPeriod          PayrollPeriod[]                @relation("PayrollPeriodCreatedBy")
  createdPayroll                Payroll[]                      @relation("PayrollCreatedBy")
  createdPayrollEarning         PayrollEarning[]               @relation("PayrollEarningCreatedBy")
  createdPayrollDeduction       PayrollDeduction[]             @relation("PayrollDeductionCreatedBy")
  createdPayrollAllocation      PayrollAllocation[]            @relation("PayrollAllocationCreatedBy")
  createdPayrollAuditLog        PayrollAuditLog[]              @relation("PayrollAuditLogCreatedBy")
  createdPayrollProfile         PayrollProfile[]               @relation("PayrollProfileCreatedBy")
  createdAttendanceSummary      AttendanceSummary[]            @relation("AttendanceSummaryCreatedBy")
  createdApprovalWorkflow       ApprovalWorkflow[]             @relation("ApprovalWorkflowCreatedBy")
  createdApprovalLevel          ApprovalLevel[]                @relation("ApprovalLevelCreatedBy")
  createdApprovalRequest        ApprovalRequest[]              @relation("ApprovalRequestCreatedBy")
  createdUserRole               UserRole[]                     @relation("UserRoleCreatedBy")
  createdReligion               Religion[]                     @relation("ReligionCreatedBy")
  createdRelationShip           RelationShip[]                 @relation("RelationShipCreatedBy")
  createdDepartment             Department[]                   @relation("DepartmentCreatedBy")
  createdJobLevel               JobLevel[]                     @relation("JobLevelCreatedBy")
  createdPayrollDeductionOther  PayrollDeductionOther[]        @relation("PayrollDeductionOtherCreatedBy")
  createdPayrollEarningOther    PayrollEarningOther[]          @relation("PayrollEarningOtherCreatedBy")
  createdPayrollEmpBank         PayrollEmpBank[]               @relation("PayrollEmpBankCreatedBy")
  createdLeaveBalance           LeaveBalance[]                 @relation("LeaveBalanceCreatedBy")
  createdHolidayCalendar        HolidayCalendar[]              @relation("HolidayCalendarCreatedBy")
  createdProjectActivity        ProjectActivity[]              @relation("ProjectActivityCreatedBy")
  createdChangeRequest          ProjectActivityChangeRequest[] @relation("ChangeRequestCreatedBy")
  createdMasterIndicator        MasterIndicator[]              @relation("MasterIndicatorCreatedBy")
  createdMEFieldMonitor         MEFieldMonitor[]               @relation("MEFieldMonitorCreatedBy")
  createdEquipmentRequest       EquipmentRequest[]             @relation("EquipmentRequestCreatedBy")
  createdEmployeeRequest        EmployeeRequest[]              @relation("EmployeeRequestCreatedBy")
  createdOfficeRole             OfficeRole[]                   @relation("OfficeRoleCreatedBy")
  createdUnit                   Unit[]                         @relation("UnitCreatedBy")
  createdWorkSchedule           WorkSchedule[]                 @relation("WorkScheduleCreatedBy")
  createdAttendanceStatus       AttendanceStatus[]             @relation("AttendanceStatusCreatedBy")
  createdTimesheet              Timesheet[]                    @relation("TimesheetCreatedBy")
  approvalRequestInitiateddBy   ApprovalRequest[]              @relation("ApprovalRequestInitiateddBy")
  createdNgpayeBand             NgpayeBand[]                   @relation("NgpayeBandCreatedBy")
  createdSalaryStructure        SalaryStructure[]              @relation("SalaryStructureCreatedBy")
  createdCurrency               Currency[]                     @relation("CurrencyCreatedBy")

  // relations deleted items 
  deletedUsers                  User[]                         @relation("UserDeletedBy")
  deletedNgpayeBand             NgpayeBand[]                   @relation("NgpayeBandDeletedBy")
  deletedSalaryStructure        SalaryStructure[]              @relation("SalaryStructureDeletedBy")
  deletedAttendanceStatus       AttendanceStatus[]             @relation("AttendanceStatusDeletedBy")
  deletedTimesheet              Timesheet[]                    @relation("TimesheetDeletedBy")
  deletedWorkSchedule           WorkSchedule[]                 @relation("WorkScheduleDeletedBy")
  deletedGrievance              Grievance[]                    @relation("GrievanceDeletedBy")
  deletedUnit                   Unit[]                         @relation("UnitDeletedBy")
  deletedOfficeRole             OfficeRole[]                   @relation("OfficeRoleDeletedBy")
  deletedEmployeeRequest        EmployeeRequest[]              @relation("EmployeeRequestDeletedBy")
  deletedEquipmentRequest       EquipmentRequest[]             @relation("EquipmentRequestDeletedBy")
  deletedMasterIndicator        MasterIndicator[]              @relation("MasterIndicatorDeletedBy")
  deletedMEFieldMonitor         MEFieldMonitor[]               @relation("MEFieldMonitorDeletedBy")
  deletedChangeRequest          ProjectActivityChangeRequest[] @relation("ChangeRequestDeletedBy")
  deletedProjectActivity        ProjectActivity[]              @relation("ProjectActivityDeletedBy")
  deletedHolidayCalendar        HolidayCalendar[]              @relation("HolidayCalendarDeletedBy")
  deletedLeaveBalance           LeaveBalance[]                 @relation("LeaveBalanceDeletedBy")
  deletedPayrollEmpBank         PayrollEmpBank[]               @relation("PayrollEmpBankDeletedBy")
  deletedPayrollDeductionOther  PayrollDeductionOther[]        @relation("PayrollDeductionOtherDeletedBy")
  deletedPayrollEarningOther    PayrollEarningOther[]          @relation("PayrollEarningOtherDeletedBy")
  deletedJobLevel               JobLevel[]                     @relation("JobLevelDeletedBy")
  deletedDepartment             Department[]                   @relation("DepartmentDeletedBy")
  deletedRelationShip           RelationShip[]                 @relation("RelationShipDeletedBy")
  deletedReligion               Religion[]                     @relation("ReligionDeletedBy")
  deletedUserRole               UserRole[]                     @relation("UserRoleDeletedBy")
  deletedApprovalRequest        ApprovalRequest[]              @relation("ApprovalRequestDeletedBy")
  deletedApprovalLevel          ApprovalLevel[]                @relation("ApprovalLevelDeletedBy")
  deletedApprovalWorkflow       ApprovalWorkflow[]             @relation("ApprovalWorkflowDeletedBy")
  deletedAttendanceSummary      AttendanceSummary[]            @relation("AttendanceSummaryDeletedBy")
  deletedPayrollAuditLog        PayrollAuditLog[]              @relation("PayrollAuditLogDeletedBy")
  deletedPayrollAllocation      PayrollAllocation[]            @relation("PayrollAllocationDeletedBy")
  deletedPayrollDeduction       PayrollDeduction[]             @relation("PayrollDeductionDeletedBy")
  deletedPayrollEarning         PayrollEarning[]               @relation("PayrollEarningDeletedBy")
  deletedPayroll                Payroll[]                      @relation("PayrollDeletedBy")
  deletedPayrollPeriod          PayrollPeriod[]                @relation("PayrollPeriodDeletedBy")
  deletedAssetDepreciation      AssetDepreciation[]            @relation("AssetDepreciationDeletedBy")
  deletedAssetDisposal          AssetDisposal[]                @relation("AssetDisposalDeletedBy")
  deletedAssetProjectAllocation AssetProjectAllocation[]       @relation("AssetProjectAllocationDeletedBy")
  deletedAssetAssignment        AssetAssignment[]              @relation("AssetAssignmentDeletedBy")
  deletedAsset                  Asset[]                        @relation("AssetDeletedBy")
  deletedAssetCategory          AssetCategory[]                @relation("AssetCategoryDeletedBy")
  deletedServiceType            ServiceType[]                  @relation("ServiceTypeDeletedBy")
  deletedIncident               Incident[]                     @relation("IncidentDeletedBy")
  deletedOfficePosition         OfficePosition[]               @relation("OfficePositionDeletedBy")
  deletedOfficeLocation         OfficeLocation[]               @relation("OfficeLocationDeletedBy")
  disciplinaryDeletedBy         DisciplinaryCase[]             @relation("DisciplinaryDeletedBy")
  deletedOrgDocs                OrgDocs[]                      @relation("OrgDocsDeletedBy")
  deletedCaseNote               CaseNote[]                     @relation("CaseNoteDeletedBy")
  deletedCaseAssessment         CaseAssessment[]               @relation("CaseAssessmentDeletedBy")
  deletedService                Service[]                      @relation("ServiceDeletedBy")
  deletedEmployee               Employee[]                     @relation("EmployeeDeletedBy")
  deletedCase                   Case[]                         @relation("CaseDeletedBy")
  deletedOrganization           Organization[]                 @relation("OrganizationDeletedBy")
  deletedEmployeeCertificate    EmployeeCertificate[]          @relation("EmployeeCertificateDeletedBy")
  deletedEmployeeDegree         EmployeeDegree[]               @relation("EmployeeDegreeDeletedBy")
  deletedTrainingEnrollment     TrainingEnrollment[]           @relation("TrainingEnrollmentDeletedBy")
  deletedTraining               Training[]                     @relation("TrainingDeletedBy")
  deletedBeneficiary            Beneficiary[]                  @relation("BeneficiaryDeletedBy")
  deletedInterventionCategory   InterventionCategory[]         @relation("InterventionCategoryDeletedBy")
  deletedLeaveType              LeaveType[]                    @relation("LeaveTypeDeletedBy")
  deletedLeaveRequest           LeaveRequest[]                 @relation("LeaveRequestDeletedBy")
  deletedAttendance             Attendance[]                   @relation("AttendanceDeletedBy")
  deletedShift                  Shift[]                        @relation("ShiftDeletedBy")
  deletedShiftEmployee          ShiftEmployee[]                @relation("ShiftEmployeeDeletedBy")
  deletedDonor                  Donor[]                        @relation("DonorDeletedBy")
  deletedProgram                Program[]                      @relation("ProgramDeletedBy")
  deletedProjectDonor           ProjectDonor[]                 @relation("ProjectDonorDeletedBy")
  deletedProjectEmployee        ProjectEmployee[]              @relation("ProjectEmployeeDeletedBy")
  deletedProject                Project[]                      @relation("ProjectDeletedBy")
  deletedEmergencyContact       EmergencyContact[]             @relation("EmergencyContactDeletedBy")
  deletedContactInfo            ContactInfo[]                  @relation("ContactInfoDeletedBy")
  deletedEmploymentHistory      EmploymentHistory[]            @relation("EmploymentHistoryDeletedBy")
  deletedPersonalInfo           PersonalInfo[]                 @relation("PersonalInfoDeletedBy")
  deletedGender                 Gender[]                       @relation("GenderDeletedBy")
  deletedVacancy                Vacancy[]                      @relation("VacancyDeletedBy")
  deletedApplicationform        Applicationform[]              @relation("ApplicationformDeletedBy")
  deletedPayrollProfile         PayrollProfile[]               @relation("PayrollProfileDeletedBy")
  deletedMarritalStatus         MarritalStatus[]               @relation("MarritalStatusDeletedBy")

  // Soft delete
  deletedAt   DateTime?
  deletedBy   User?     @relation("UserDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  deletedById String?

  // creator  
  createdBy           User?                 @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById         String?
  BeneficiaryFollowUp BeneficiaryFollowUp[]
}

model Grievance {
  id          String          @id @default(uuid())
  subject     String
  description String
  type        GrievanceType   @default(GRIEVANCE)
  status      GrievanceStatus @default(SUBMITTED)
  isAnonymous Boolean         @default(false)

  beneficiaryId String?
  beneficiary   Beneficiary? @relation(fields: [beneficiaryId], references: [id])

  submittedAt DateTime  @default(now())
  resolvedAt  DateTime?
  employeeId  String?
  employee    Employee? @relation("EmployeeGrievances", fields: [employeeId], references: [id])

  assignedToId String?
  assignedTo   Employee? @relation("GrievanceAssignedTo", fields: [assignedToId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  caseId    String?
  case      Case?    @relation(fields: [caseId], references: [id])

  deletedAt   DateTime?
  deletedBy   User?     @relation("GrievanceDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  deletedById String?

  createdBy   User?   @relation("GrievanceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?

  @@index([employeeId])
  @@index([status])
}

model BeneficiaryRequest {
  id            String      @id @default(uuid())
  beneficiaryId String
  beneficiary   Beneficiary @relation(fields: [beneficiaryId], references: [id])
  requestType   RequestType
  title         String
  description   String?

  submittedById   String?
  submittedBy     User?         @relation("RequestSubmittedBy", fields: [submittedById], references: [id])
  amountRequested Float?
  amountApproved  Float?
  status          RequestStatus @default(PENDING)
  priority        Priority      @default(MEDIUM)

  assignedToId    String?
  assignedTo      User?     @relation(fields: [assignedToId], references: [id])
  approvalDate    DateTime?
  rejectionReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([beneficiaryId])
  @@index([status])
  @@index([requestType])
}

model UserRoleAssignment {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  role      UserRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId    String
  createdAt DateTime @default(now())

  @@unique([userId, roleId]) // prevent duplicates
}

model UserRole {
  id             String                 @id @default(uuid())
  name           String                 @unique
  code           String?
  users          UserRoleAssignment[]
  approvalLevels ApprovalLevel[]
  permissions    RoleModulePermission[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  deletedBy   User?     @relation("UserRoleDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  deletedById String?

  createdBy   User?   @relation("UserRoleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
}

model Module {
  id          String                 @id @default(uuid())
  name        String                 @unique // e.g. "BENEFICIARY", "HR", "INVENTORY"
  code        String                 @unique // e.g. "BENEFICIARY", "HR", "INVENTORY"
  description String?
  permissions RoleModulePermission[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
}

model RoleModulePermission {
  id     String   @id @default(uuid())
  role   UserRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId String

  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  moduleId String

  canCreate Boolean @default(false)
  canRead   Boolean @default(true)
  canUpdate Boolean @default(false)
  canDelete Boolean @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User?    @relation("RoleModulePermissionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?

  @@unique([roleId, moduleId]) // Prevent duplicates
}

model EquipmentRequest {
  id              String        @id @default(uuid())
  assetCategory   AssetCategory @relation(fields: [assetCategoryId], references: [id], onDelete: Cascade)
  assetCategoryId String

  // Optional relations – connect whichever makes sense
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  employeeId String?

  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId String?
  // Add more: departmentId, organizationId, etc. if needed
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletedAt   DateTime?
  deletedBy   User?     @relation("EquipmentRequestDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  deletedById String?

  createdBy   User?   @relation("EquipmentRequestCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
}

// stores user roles for access management with permission

model Employee {
  id              String           @id @default(uuid())
  empId           String?          @unique
  status          EmploymentStatus @default(ACTIVE)
  hireDate        DateTime
  recordStatus    RecordStatus     @default(PENDING_APPROVAL)
  terminationDate DateTime?
  url             String?
  file            String?
  originalName    String?
  avatar          String?
  genderId        String?
  gender          Gender?          @relation(fields: [genderId], references: [id])

  fname String
  lname String
  mname String?

  feedbackReviewerEmpBank   PerformanceFeedback[]       @relation("FeedbackReviewer")
  employeeFeedBankBank      PerformanceFeedback[]       @relation("FeedbackEmployee")
  employeeAppraisal         PerformanceAppraisal[]      @relation("EmployeeAppraisal")
  managerAppraisal          PerformanceAppraisal[]      @relation("ManagerAppraisal")
  payrollEmpBank            PayrollEmpBank[]
  performanceGoal           PerformanceGoal[]
  employeeRequestAssignedTo EmployeeRequest[]           @relation("EmployeeRequestAssignedTo")
  equipmentRequest          EquipmentRequest[]
  leaveBalance              LeaveBalance[]
  beneficiary               Beneficiary[]
  promotionRequest          PromotionRequest[]
  employeeAttendanceProfile EmployeeAttendanceProfile[]
  orgDocs                   OrgDocs[]
  beneficiaryAttendance     BeneficiaryAttendance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // New Relations
  projects              ProjectEmployee[] //one-many
  contactInfo           ContactInfo[]
  attendanceSummary     AttendanceSummary[]
  attendance            Attendance[]
  payroll               Payroll[]
  beneficiaryFieldVisit BeneficiaryFieldVisit[]
  vacancy               Vacancy[]               @relation("VacancyAssignedTo")
  grievanceEmployee     Grievance[]             @relation("EmployeeGrievances")
  grievanceAssigned     Grievance[]             @relation("GrievanceAssignedTo")
  disposedAssets        AssetDisposal[]         @relation("AssetDisposedBy")

  cases              Case[]
  caseNotes          CaseNote[]
  createdAssessments CaseAssessment[]

  leaveRequest              LeaveRequest[]
  personalInfo              PersonalInfo[]
  trainingEnrollment        TrainingEnrollment[]
  employmentSupervisor      EmploymentHistory[]  @relation("EmploymentSupervisor")
  employeeEmploymentHistory EmploymentHistory[]  @relation("EmployeeEmploymentHistory")
  disciplinaryCase          DisciplinaryCase[]   @relation("EmployeeDisciplinaryCases")
  emergencyContact          EmergencyContact[]
  employeesShift            ShiftEmployee[]
  user                      User? // one-one
  payrollProfile            PayrollProfile?

  // ── Current reporting line (denormalized / maintained via trigger or app logic) ──
  currentSupervisorId String?
  currentSupervisor   Employee?  @relation("CurrentReportsTo", fields: [currentSupervisorId], references: [id])
  directReports       Employee[] @relation("CurrentReportsTo")

  // ── New skill fields ────────────────────────────────────────
  technicalSkills   String? // "React, TypeScript, Node.js, Docker, AWS"
  softSkills        String? // "Leadership, Communication, Teamwork, Problem Solving"
  itSkills          String? // "Excel, Power BI, SQL, Python scripting, Linux"
  projectActivity   ProjectActivity? @relation(fields: [projectActivityId], references: [id], onDelete: SetNull)
  projectActivityId String?
  // Soft delete + audit
  deletedAt         DateTime?
  deletedBy         User?            @relation("EmployeeDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  deletedById       String?

  // creator  
  createdBy           User?                 @relation("EmployeeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById         String?
  employeeDegree      EmployeeDegree[]
  employeeCertificate EmployeeCertificate[]
  assetAssignment     AssetAssignment[]
  Loan                Loan[]
  Overtime            Overtime[]
}

model BeneficiaryAttendance {
  id            String      @id @default(uuid())
  beneficiaryId String
  beneficiary   Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)

  interventionBatchId String
  interventionBatch   InterventionBatch @relation(fields: [interventionBatchId], references: [id], onDelete: Cascade)

  statusId String?
  status   AttendanceStatus? @relation(fields: [statusId], references: [id])

  notes        String?
  recordedById String?
  recordedBy   Employee? @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([statusId])
}

model BeneficiaryFieldVisit {
  id            String      @id @default(uuid())
  beneficiaryId String
  beneficiary   Beneficiary @relation(fields: [beneficiaryId], references: [id])

  visitedById String?
  visitedBy   Employee? @relation(fields: [visitedById], references: [id])

  visitDate DateTime
  visitType VisitType

  purpose      String?
  observations String?
  assessment   String?

  locationLat Float?
  locationLng Float?

  status        VisitStatus           @default(COMPLETED)
  nextVisitDate DateTime?
  followUps     BeneficiaryFollowUp[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([beneficiaryId])
  @@index([visitDate])
}

model PerformanceDevelopmentPlan {
  id          String               @id @default(uuid())
  employeeId  String
  appraisalId String
  strengths   String?
  weaknesses  String?
  actionPlan  String?
  createdAt   DateTime             @default(now())
  appraisal   PerformanceAppraisal @relation(fields: [appraisalId], references: [id])
}

model PerformanceRatingScale {
  id    String @id @default(uuid())
  name  String
  score Float
}

model PerformanceFeedback {
  id         String @id @default(uuid())
  employeeId String
  reviewerId String

  cycleId String

  comment String
  rating  Float?

  createdAt DateTime @default(now())

  employee Employee @relation("FeedbackEmployee", fields: [employeeId], references: [id])
  reviewer Employee @relation("FeedbackReviewer", fields: [reviewerId], references: [id])
}

model PerformanceAppraisalRating {
  id          String  @id @default(uuid())
  appraisalId String
  goalId      String
  score       Float
  comment     String?

  appraisal PerformanceAppraisal @relation(fields: [appraisalId], references: [id])
  goal      PerformanceGoal      @relation(fields: [goalId], references: [id])

  @@unique([appraisalId, goalId])
}

model PerformanceGoal {
  id           String       @id @default(uuid())
  employeeId   String
  cycleId      String
  recordStatus RecordStatus @default(PENDING_APPROVAL)

  title         String
  description   String?
  weight        Float
  targetValue   Float?
  achievedValue Float?

  progress Float? // percentage

  employee Employee         @relation(fields: [employeeId], references: [id])
  cycle    PerformanceCycle @relation(fields: [cycleId], references: [id])

  ratings   PerformanceAppraisalRating[]
  createdAt DateTime                     @default(now())
}

model PerformanceCycle {
  id           String       @id @default(uuid())
  name         String
  startDate    DateTime
  endDate      DateTime
  status       CycleStatus
  recordStatus RecordStatus @default(PENDING_APPROVAL)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  goals      PerformanceGoal[]
  appraisals PerformanceAppraisal[]
}

model PerformanceAppraisal {
  id         String @id @default(uuid())
  employeeId String
  managerId  String
  cycleId    String

  selfComment    String?
  managerComment String?
  hrComment      String?

  finalScore Float?
  status     AppraisalStatus

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation("EmployeeAppraisal", fields: [employeeId], references: [id])
  manager  Employee @relation("ManagerAppraisal", fields: [managerId], references: [id])

  cycle                      PerformanceCycle             @relation(fields: [cycleId], references: [id])
  ratings                    PerformanceAppraisalRating[]
  performanceDevelopmentPlan PerformanceDevelopmentPlan[]
}

model UserSettings {
  id String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  // Dashboard
  defaultLandingPage String? // dashboard, employees, payroll
  dashboardLayout    String? // compact, expanded

  // Data View
  defaultDataView String? // table, grid
  pageSize        Int? // 10, 25, 50

  // Notifications
  emailNotifications    Boolean @default(true)
  workflowNotifications Boolean @default(true)
  payrollNotifications  Boolean @default(true)

  // Localization
  timezone   String? @default("Africa/Lagos")
